# Copy to .env (never commit it). Both values stay on the server.
HOPLITE_API_URL=https://api.hoplite.sh
HOPLITE_SERVICE_KEY=

# Optional: gate every draft on the full browser checks (default off).
# STUDIO_QA_CHECKS=on

# Optional: a shared access password for a hosted copy. The session secret
# must be at least 32 characters, for example: openssl rand -base64 48
# STUDIO_ACCESS_PASSWORD=
# STUDIO_SESSION_SECRET=

# Optional: your own S3-compatible release storage. Omit for local files.
# Credentials come from the server's standard AWS credential chain.
# STUDIO_RELEASE_BUCKET=
# STUDIO_RELEASE_REGION=
# STUDIO_RELEASE_PREFIX=studio
# STUDIO_RELEASE_ENDPOINT=

# Optional: a custom sandbox image id that Hoplite provided and enabled for
# your workspace on request (support@hoplite.sh).
# STUDIO_STARTER_IMAGE=
