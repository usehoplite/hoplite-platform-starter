{
  "name": "site-studio",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx server.ts",
    "build": "next build --webpack",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=../../.env --import tsx server.ts",
    "test:browser": "node --import tsx --test tests/*.acceptance.ts",
    "test:lifecycle": "node --import tsx --test tests/server.lifecycle.ts",
    "test:storage": "node --import tsx --test tests/release-storage.live.ts",
    "starter:prepare": "node --import tsx ../../prepare-starter.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1050.0",
    "@axe-core/playwright": "^4.13.0",
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "http-proxy": "^1.18.1",
    "ipaddr.js": "2.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.2.11",
    "playwright": "^1.58.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.3.1",
    "tar": "^7.5.7",
    "@astrojs/compiler": "2.13.1",
    "css-tree": "3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24",
    "@types/react": "^19.2",
    "@types/react-dom": "^19.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5.9.3",
    "@types/css-tree": "3.2.0"
  }
}
